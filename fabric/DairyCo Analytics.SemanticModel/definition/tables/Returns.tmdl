/// Customer return lines (grain: return line). Dated by return date; returns can arrive after the sales period.
table Returns

	/// Value of returned goods at invoice net price; EGP.
	measure 'Return Value' = SUM('Returns'[Return Value Amount])
		formatString: #,##0
		displayFolder: Returns

	/// Units returned.
	measure 'Returned Units' = SUM('Returns'[Returned Quantity])
		formatString: #,##0
		displayFolder: Returns

	/// Return value / net revenue, both by their own date (return date vs invoice date).
	measure 'Return Rate %' = DIVIDE([Return Value], [Net Revenue])
		formatString: 0.00%
		displayFolder: Returns

	column 'Return Id'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: return_id

	column 'Invoice Id'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: invoice_id

	column 'Date Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: date_key

	column 'Invoice Date Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: invoice_date_key

	column 'Customer Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: customer_key

	column 'Product Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: product_key

	column 'Region Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: region_key

	column 'Returned Quantity'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: returned_quantity

	column 'Return Value Amount'
		dataType: decimal
		isHidden
		summarizeBy: none
		sourceColumn: return_value

	column 'Return Reason'
		dataType: string
		summarizeBy: none
		sourceColumn: return_reason

	column 'Distributor Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: distributor_key

	partition Returns = entity
		mode: directLake
		source
			entityName: fact_returns
			expressionSource: 'DirectLake - Gold'


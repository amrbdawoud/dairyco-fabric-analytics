/// Salesforce opportunities (grain: opportunity), dated by created month. CRM covers Modern Trade and Key
/// Accounts only.
table 'CRM Opportunity'

	/// Value of open opportunities.
	measure 'Open Pipeline Value' = CALCULATE(SUM('CRM Opportunity'[Opportunity Value]), 'CRM Opportunity'[Is Open] = TRUE())
		formatString: #,##0
		displayFolder: CRM

	/// Open pipeline already past its expected close date.
	measure 'Stale Pipeline %' = DIVIDE(CALCULATE(SUM('CRM Opportunity'[Opportunity Value]), 'CRM Opportunity'[Is Stale] = TRUE()), [Open Pipeline Value])
		formatString: 0.0%
		displayFolder: CRM

	/// Won / closed opportunities (count).
	measure 'Win Rate %' = DIVIDE(CALCULATE(COUNTROWS('CRM Opportunity'), 'CRM Opportunity'[Is Won] = TRUE()), CALCULATE(COUNTROWS('CRM Opportunity'), 'CRM Opportunity'[Is Open] = FALSE()))
		formatString: 0.0%
		displayFolder: CRM

	/// Value of won opportunities (CRM scale differs from ERP revenue).
	measure 'Closed Won Value' = CALCULATE(SUM('CRM Opportunity'[Opportunity Value]), 'CRM Opportunity'[Is Won] = TRUE())
		formatString: #,##0
		displayFolder: CRM

	column 'Opportunity Id'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: opportunity_id

	column 'Date Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: date_key

	column 'Customer Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: customer_key

	column 'Region Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: region_key

	column 'Opportunity Value'
		dataType: decimal
		isHidden
		summarizeBy: none
		sourceColumn: opportunity_value

	column Stage
		dataType: string
		summarizeBy: none
		sourceColumn: stage

	column 'Opportunity Type'
		dataType: string
		summarizeBy: none
		sourceColumn: opportunity_type

	column 'Is Open'
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_open

	column 'Is Stale'
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_stale

	column 'Is Won'
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_won

	column 'Expected Close Date Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: expected_close_date_key

	partition 'CRM Opportunity' = entity
		mode: directLake
		source
			entityName: fact_crm_opportunity
			expressionSource: 'DirectLake - Gold'


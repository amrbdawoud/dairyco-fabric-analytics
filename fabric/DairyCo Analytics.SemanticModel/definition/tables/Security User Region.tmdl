/// RLS mapping: user principal name -> permitted region. Maintained by the BI owner (production: synced from
/// Entra ID groups).
table 'Security User Region'
	isHidden

	column 'User UPN'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: user_upn

	column 'Region Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: region_key

	partition 'Security User Region' = entity
		mode: directLake
		source
			entityName: security_user_region
			expressionSource: 'DirectLake - Gold'


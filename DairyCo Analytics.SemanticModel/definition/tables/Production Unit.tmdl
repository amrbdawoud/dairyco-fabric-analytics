/// Plant x line x shift (18 units) - conformed between production orders and aggregated labour.
table 'Production Unit'

	column 'Production Unit Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: production_unit_key

	column Plant
		dataType: string
		summarizeBy: none
		sourceColumn: plant

	column Line
		dataType: string
		summarizeBy: none
		sourceColumn: line

	column Shift
		dataType: string
		summarizeBy: none
		sourceColumn: shift

	column 'Plant Id'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: plant_id

	column 'Line Id'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: line_id

	column 'Production Unit'
		dataType: string
		summarizeBy: none
		sourceColumn: production_unit

	hierarchy 'Plant Hierarchy'

		level Plant
			column: Plant

		level Line
			column: Line

		level Shift
			column: Shift

	partition 'Production Unit' = entity
		mode: directLake
		source
			entityName: dim_production_unit
			expressionSource: 'DirectLake - Gold'


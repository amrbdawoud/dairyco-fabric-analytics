/// Latest result of every silver data-quality rule (flag, don't silently fix).
table 'Data Quality'

	/// Rows violating data-quality rules at the last run.
	measure 'DQ Violations' = SUM('Data Quality'[Violations Count])
		formatString: #,##0
		displayFolder: Data Quality

	/// Rules with at least one violation.
	measure 'DQ Rules Breached' = CALCULATE(COUNTROWS('Data Quality'), 'Data Quality'[Violations Count] > 0)
		formatString: #,##0
		displayFolder: Data Quality

	column Entity
		dataType: string
		summarizeBy: none
		sourceColumn: entity

	column 'Rule Id'
		dataType: string
		summarizeBy: none
		sourceColumn: rule_id

	column Rule
		dataType: string
		summarizeBy: none
		sourceColumn: rule

	column Severity
		dataType: string
		summarizeBy: none
		sourceColumn: severity

	column 'Violations Count'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: violations

	column 'DQ Batch'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: batch_id

	column 'Checked At'
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn
		summarizeBy: none
		sourceColumn: run_at

	partition 'Data Quality' = entity
		mode: directLake
		source
			entityName: dq_summary
			expressionSource: 'DirectLake - Gold'


/// Warehouse x SKU recommendation from nb_05: target stock = ML forecast daily demand x (50% of shelf life); gap
/// = on hand - target.
table 'Stock Rebalancing'

	/// Stock above target cover, at standard cost.
	measure 'Excess Stock Value' = CALCULATE(SUM('Stock Rebalancing'[Stock Gap Value]), 'Stock Rebalancing'[Stock Gap] > 0)
		formatString: #,##0
		displayFolder: AI Forecast

	/// Units below target cover (stockout risk).
	measure 'Stock Shortfall Units' = -CALCULATE(SUM('Stock Rebalancing'[Stock Gap]), 'Stock Rebalancing'[Stock Gap] < 0) + 0
		formatString: #,##0
		displayFolder: AI Forecast

	column 'Warehouse Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: warehouse_key

	column 'Product Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: product_key

	column 'Region Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: region_key

	column 'On Hand'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: on_hand

	column 'Near Expiry Qty'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: near_expiry_qty

	column 'Forecast Daily Demand'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: forecast_daily_demand

	column 'Target Cover Days'
		dataType: decimal
		formatString: #,##0.0
		summarizeBy: none
		sourceColumn: target_cover_days

	column 'Current Cover Days'
		dataType: double
		formatString: #,##0.0
		summarizeBy: none
		sourceColumn: current_cover_days

	column 'Target Stock'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: target_stock

	column 'Stock Gap'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: stock_gap

	column 'Stock Gap Value'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: stock_gap_value

	column 'Recommended Action'
		dataType: string
		summarizeBy: none
		sourceColumn: action

	column 'Rebalancing Run Id'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: model_run_id

	partition 'Stock Rebalancing' = entity
		mode: directLake
		source
			entityName: ml_stock_rebalancing
			expressionSource: 'DirectLake - Gold'


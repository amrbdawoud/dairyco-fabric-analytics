/// One row per promotion, dated by promotion start. Baseline = same product+region daily run-rate in the 8 weeks
/// before the promotion (excluding other promotions). Incremental GP = promo-window GP minus baseline GP.
table 'Promotion Performance'

	/// Trade support paid for the promotions in context; EGP.
	measure 'Promotion Support Cost' = SUM('Promotion Performance'[Support Cost])
		formatString: #,##0
		displayFolder: Promotions

	/// Gross profit above the pre-promotion baseline; EGP.
	measure 'Incremental Gross Profit' = SUM('Promotion Performance'[Incremental GP])
		formatString: #,##0
		displayFolder: Promotions

	/// Incremental gross profit less support cost; negative = value destroyed.
	measure 'Net Promotion Return' = SUM('Promotion Performance'[Net Promo Return])
		formatString: #,##0
		displayFolder: Promotions

	/// Net promotion return / support cost.
	measure 'Promotion ROI %' = DIVIDE([Net Promotion Return], [Promotion Support Cost])
		formatString: 0.0%
		displayFolder: Promotions

	/// Number of promotions.
	measure 'Promotions Run' = COUNTROWS('Promotion Performance')
		formatString: #,##0
		displayFolder: Promotions

	/// Promotions with a measurable baseline whose incremental GP exceeded support cost.
	measure 'Promotions Paying Back' = CALCULATE(COUNTROWS('Promotion Performance'), 'Promotion Performance'[Net Promo Return] > 0, 'Promotion Performance'[Baseline Measurable] = TRUE()) + 0
		formatString: #,##0
		displayFolder: Promotions

	/// Mean unit uplift vs baseline across measurable promotions.
	measure 'Average Volume Lift %' = CALCULATE(AVERAGE('Promotion Performance'[Volume Lift]), 'Promotion Performance'[Baseline Measurable] = TRUE())
		formatString: 0.0%
		displayFolder: Promotions

	/// Average discount actually on invoices during the promotion window (compare with stated discount).
	measure 'Discount Applied on Invoice %' = AVERAGE('Promotion Performance'[Discount Applied On Invoice])
		formatString: 0.0%
		displayFolder: Promotions

	/// Units above baseline.
	measure 'Promotion Incremental Units' = SUM('Promotion Performance'[Incremental Units])
		formatString: #,##0
		displayFolder: Promotions

	/// Promotions with at least 28 baseline trading days in the 8 weeks before start.
	measure 'Measurable Promotions' = CALCULATE(COUNTROWS('Promotion Performance'), 'Promotion Performance'[Baseline Measurable] = TRUE()) + 0
		formatString: #,##0
		displayFolder: Promotions

	column 'Promotion Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: promotion_key

	column 'Product Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: product_key

	column 'Region Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: region_key

	column 'Performance Promotion Type'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: promotion_type

	column 'Promo Days'
		dataType: int64
		summarizeBy: none
		sourceColumn: promo_days

	column 'Discount Stated'
		dataType: decimal
		isHidden
		summarizeBy: none
		sourceColumn: discount_pct

	column 'Discount Applied On Invoice'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: discount_applied_on_invoice

	column 'Support Cost'
		dataType: decimal
		isHidden
		summarizeBy: none
		sourceColumn: support_cost

	column 'Promo Units'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: promo_units

	column 'Baseline Units'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: baseline_units

	column 'Incremental Units'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: incremental_units

	column 'Volume Lift'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: volume_lift_pct

	column 'Promo Net Sales'
		dataType: decimal
		isHidden
		summarizeBy: none
		sourceColumn: promo_net_sales

	column 'Promo GP'
		dataType: decimal
		isHidden
		summarizeBy: none
		sourceColumn: promo_gp

	column 'Baseline GP'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: baseline_gp

	column 'Incremental GP'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: incremental_gp

	column 'Net Promo Return'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: net_promo_return

	column 'Promo ROI'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: promo_roi

	column 'Baseline Measurable'
		dataType: boolean
		summarizeBy: none
		sourceColumn: baseline_measurable

	column 'Date Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: date_key

	partition 'Promotion Performance' = entity
		mode: directLake
		source
			entityName: fact_promo_performance
			expressionSource: 'DirectLake - Gold'


/// Regional managers: rows limited to regions mapped to their UPN in Security User Region. Manufacturing and
/// aggregated workforce KPIs are company-wide and visible, but labour cost columns are hidden (OLS).
role 'Regional Manager'
	modelPermission: read

	tablePermission Region = 'Region'[Region Key] IN CALCULATETABLE(VALUES('Security User Region'[Region Key]), 'Security User Region'[User UPN] = USERPRINCIPALNAME())

	tablePermission Customer = 'Customer'[Customer Region Key] IN CALCULATETABLE(VALUES('Security User Region'[Region Key]), 'Security User Region'[User UPN] = USERPRINCIPALNAME())

	tablePermission Distributor = 'Distributor'[Distributor Region Key] IN CALCULATETABLE(VALUES('Security User Region'[Region Key]), 'Security User Region'[User UPN] = USERPRINCIPALNAME())

	tablePermission Warehouse = 'Warehouse'[Warehouse Region Key] IN CALCULATETABLE(VALUES('Security User Region'[Region Key]), 'Security User Region'[User UPN] = USERPRINCIPALNAME())

	tablePermission 'Security User Region' = 'Security User Region'[User UPN] = USERPRINCIPALNAME()

	tablePermission Labour

		columnPermission 'Overtime Cost Amount' = none

		columnPermission 'Base Salary Amount' = none

		columnPermission 'Allowances Amount' = none

		columnPermission 'Total Labour Cost Amount' = none


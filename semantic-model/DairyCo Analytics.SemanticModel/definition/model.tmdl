model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	discourageImplicitMeasures

	annotation __PBI_TimeIntelligenceEnabled = 0

ref table Date
ref table Product
ref table Region
ref table Customer
ref table Distributor
ref table Warehouse
ref table Promotion
ref table 'Production Unit'
ref table Sales
ref table Returns
ref table 'Sales Target'
ref table 'Promotion Performance'
ref table 'Inventory Snapshot'
ref table 'Distributor Month'
ref table 'Demand Forecast'
ref table Production
ref table Labour
ref table 'CRM Opportunity'
ref table 'CRM Activity'
ref table 'ML Demand Forecast'
ref table 'Stock Rebalancing'
ref table 'Data Quality'
ref table 'Security User Region'

ref role Executive
ref role 'Regional Manager'


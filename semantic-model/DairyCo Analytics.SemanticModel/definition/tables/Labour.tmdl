/// Payroll and attendance AGGREGATED to month x plant x line x shift (minimum 5 employees per cell). No employee-
/// level pay is in the model. Cost columns are hidden from the Regional Manager role (OLS).
table Labour

	/// Base + overtime + allowances; EGP. Restricted (OLS).
	measure 'Labour Cost' = SUM('Labour'[Total Labour Cost Amount])
		formatString: #,##0
		displayFolder: Workforce

	/// Overtime pay; EGP. Restricted (OLS).
	measure 'Overtime Cost' = SUM('Labour'[Overtime Cost Amount])
		formatString: #,##0
		displayFolder: Workforce

	/// Overtime share of labour cost.
	measure 'Overtime % of Labour Cost' = DIVIDE([Overtime Cost], [Labour Cost])
		formatString: 0.0%
		displayFolder: Workforce

	/// Overtime hours worked.
	measure 'Overtime Hours Total' = SUM('Labour'[Overtime Hours])
		formatString: #,##0
		displayFolder: Workforce

	/// Sum of monthly headcount (employee-months).
	measure 'Employee Months' = SUM('Labour'[Headcount])
		formatString: #,##0
		displayFolder: Workforce

	/// Average monthly headcount.
	measure 'Average Headcount' = AVERAGEX(VALUES('Date'[Year Month]), CALCULATE(SUM('Labour'[Headcount])))
		formatString: #,##0
		displayFolder: Workforce

	/// Overtime hours per employee per month.
	measure 'Overtime Hours per Employee' = DIVIDE([Overtime Hours Total], [Employee Months])
		formatString: #,##0.0
		displayFolder: Workforce

	/// Absence hours / scheduled hours.
	measure 'Absence Rate %' = ```
			VAR _abs = SUM('Labour'[Absence Hours])
			RETURN DIVIDE(_abs, SUM('Labour'[Attendance Hours]) + _abs)
			```
		formatString: 0.0%
		displayFolder: Workforce

	/// Labour cost / good units produced. CAVEAT: payroll appears to be on a larger scale than production volume; use
	/// for relative comparison.
	measure 'Labour Cost per Good Unit' = DIVIDE([Labour Cost], [Good Units])
		formatString: #,##0.00
		displayFolder: Workforce

	column 'Date Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: date_key

	column 'Production Unit Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: production_unit_key

	column Headcount
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: headcount

	column 'Attendance Hours'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: attendance_hours

	column 'Absence Hours'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: absence_hours

	column 'Overtime Hours'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: overtime_hours

	column 'Overtime Cost Amount'
		dataType: decimal
		isHidden
		summarizeBy: none
		sourceColumn: overtime_cost

	column 'Base Salary Amount'
		dataType: decimal
		isHidden
		summarizeBy: none
		sourceColumn: base_salary

	column 'Allowances Amount'
		dataType: decimal
		isHidden
		summarizeBy: none
		sourceColumn: allowances

	column 'Total Labour Cost Amount'
		dataType: decimal
		isHidden
		summarizeBy: none
		sourceColumn: total_labour_cost

	partition Labour = entity
		mode: directLake
		source
			entityName: fact_labour_month
			expressionSource: 'DirectLake - Gold'


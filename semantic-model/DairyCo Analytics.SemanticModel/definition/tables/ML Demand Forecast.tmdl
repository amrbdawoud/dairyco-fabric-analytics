/// Output of nb_05 (MLflow-tracked). record_type 'backtest' = rolling-origin out-of-sample months; 'forecast' =
/// next month.
table 'ML Demand Forecast'

	/// Machine-learning forecast units.
	measure 'ML Forecast Units' = SUM('ML Demand Forecast'[ML Forecast Qty])
		formatString: #,##0
		displayFolder: AI Forecast

	/// Out-of-sample weighted absolute % error of the ML model.
	measure 'ML Backtest WAPE %' = ```
			VAR _bt = FILTER('ML Demand Forecast', 'ML Demand Forecast'[Record Type] = "backtest")
			RETURN DIVIDE(SUMX(_bt, ABS('ML Demand Forecast'[ML Forecast Qty] - 'ML Demand Forecast'[Backtest Actual Qty])), SUMX(_bt, 'ML Demand Forecast'[Backtest Actual Qty]))
			```
		formatString: 0.0%
		displayFolder: AI Forecast

	/// Weighted absolute % error of the incumbent MRP forecast over the same backtest months.
	measure 'MRP Backtest WAPE %' = ```
			VAR _bt = FILTER('ML Demand Forecast', 'ML Demand Forecast'[Record Type] = "backtest")
			RETURN DIVIDE(SUMX(_bt, ABS('ML Demand Forecast'[MRP Forecast Qty] - 'ML Demand Forecast'[Backtest Actual Qty])), SUMX(_bt, 'ML Demand Forecast'[Backtest Actual Qty]))
			```
		formatString: 0.0%
		displayFolder: AI Forecast

	/// Error of the rule-based challenger (MRP x trailing 3-month actual/forecast ratio) over the same backtest
	/// months.
	measure 'Rule Backtest WAPE %' = ```
			VAR _bt = FILTER('ML Demand Forecast', 'ML Demand Forecast'[Record Type] = "backtest")
			RETURN DIVIDE(SUMX(_bt, ABS('ML Demand Forecast'[Rule Forecast Qty] - 'ML Demand Forecast'[Backtest Actual Qty])), SUMX(_bt, 'ML Demand Forecast'[Backtest Actual Qty]))
			```
		formatString: 0.0%
		displayFolder: AI Forecast

	/// Bias-corrected MRP forecast units (rule).
	measure 'Rule Forecast Units' = SUM('ML Demand Forecast'[Rule Forecast Qty])
		formatString: #,##0
		displayFolder: AI Forecast

	column 'Date Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: date_key

	column 'Product Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: product_key

	column 'Record Type'
		dataType: string
		summarizeBy: none
		sourceColumn: record_type

	column 'Backtest Actual Qty'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: actual_qty

	column 'MRP Forecast Qty'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: mrp_forecast

	column 'Naive Forecast Qty'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: naive_forecast

	column 'Rule Forecast Qty'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: rule_forecast

	column 'ML Forecast Qty'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: ml_forecast

	column 'Model Run Id'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: model_run_id

	partition 'ML Demand Forecast' = entity
		mode: directLake
		source
			entityName: ml_demand_forecast
			expressionSource: 'DirectLake - Gold'


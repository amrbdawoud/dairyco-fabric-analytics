/// DairyCo distribution centres (one per region).
table Warehouse

	column 'Warehouse Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: warehouse_key

	column Warehouse
		dataType: string
		summarizeBy: none
		sourceColumn: warehouse_name

	column 'Warehouse Region Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: region_key

	column 'Warehouse Region'
		dataType: string
		summarizeBy: none
		sourceColumn: region

	partition Warehouse = entity
		mode: directLake
		source
			entityName: dim_warehouse
			expressionSource: 'DirectLake - Gold'


/// Calendar 2025-2026 (daily). Egyptian weekend = Friday/Saturday. 'Is Actuals Period' marks dates up to the last
/// loaded invoice date and is used to keep year-on-year comparisons like-for-like.
table Date
	dataCategory: Time

	column 'Date Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: date_key

	column Date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: date

	column Year
		dataType: int64
		summarizeBy: none
		sourceColumn: year

	column Quarter
		dataType: int64
		summarizeBy: none
		sourceColumn: quarter

	column 'Month Number'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: month_num

	column Month
		dataType: string
		summarizeBy: none
		sortByColumn: 'Month Number'
		sourceColumn: month_name

	column 'Year Month'
		dataType: string
		summarizeBy: none
		sourceColumn: year_month

	column 'Month Start'
		dataType: dateTime
		formatString: mmm yyyy
		summarizeBy: none
		sourceColumn: month_start

	column 'Week Start'
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: week_start

	column 'Day Name'
		dataType: string
		summarizeBy: none
		sortByColumn: 'Day Of Week'
		sourceColumn: day_name

	column 'Day Of Week'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: day_of_week

	column 'Is Weekend'
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_weekend

	column 'Is Actuals Period'
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_actuals_period

	hierarchy Calendar

		level Year
			column: Year

		level Quarter
			column: Quarter

		level Month
			column: Month

		level Date
			column: Date

	partition Date = entity
		mode: directLake
		source
			entityName: dim_date
			expressionSource: 'DirectLake - Gold'

